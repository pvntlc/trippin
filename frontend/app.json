{
  "expo": {
    "name": "Trippin",
    "slug": "trippin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "trippin",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f8fd6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trippin.app"
    },
    "android": {
      "package": "com.trippin.app",
      "versionCode": 6,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Trippin",
      "shortName": "Trippin",
      "description": "해외여행 일정을 한 곳에서",
      "themeColor": "#1f8fd6",
      "backgroundColor": "#1f8fd6"
    },
    "extra": {
      "eas": {
        "projectId": "3b3a7626-db68-4be8-b73f-ab1e386553e3"
      }
    },
    "owner": "pvntic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "여행지에 있을 때 지출 빠른 기록을 제안하기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "영수증을 촬영해 지출을 자동 입력하기 위해 카메라를 사용합니다.",
          "photosPermission": "영수증 사진을 불러오기 위해 사진 접근이 필요합니다."
        }
      ]
    ]
  }
}